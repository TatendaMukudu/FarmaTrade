DATABASE_URL="postgresql://user:password@localhost:5432/farmatrade?schema=public"
SESSION_SECRET="generate-a-long-random-string-for-this"

# From your Sentry project's Client Keys (DSN) settings. Set on both names —
# server/edge code reads SENTRY_DSN, the browser bundle only inlines
# NEXT_PUBLIC_-prefixed vars.
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
