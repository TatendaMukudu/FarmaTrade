// FarmaTrade data model.
//
// Single connected graph: every farm, buyer, seller, and transporter is a
// Party. A Party can extend itself with a Farm profile (asset inventory)
// and/or a TransportProfile (hauling capacity) — these aren't separate
// systems, just optional facets of the same node.
//
// Trading is symmetric: a Party posts what it HAS or what it NEEDS, and
// the matching engine pairs HAVE posts against NEED posts. No payment
// rails — settlement happens off-platform (cash, EcoCash, bank transfer).
// Reputation is seeded by self-reported transaction confirmations from
// both sides of a match, not by verified payment data (that's a known,
// deliberate weak point until a licensed payment aggregator is wired in).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & parties
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())

  // Embedded in every session JWT and checked on every request. Sessions
  // are otherwise stateless 30-day tokens with no server-side record to
  // revoke — bumping this is the only way to invalidate outstanding
  // tokens (a future "log out everywhere" action, or a password change).
  sessionVersion Int @default(0)

  party Party?
}

// What a participant can *do* in the agricultural economy, not what they
// "are". Replaces the original three-role model (FARM/TRADER/TRANSPORTER),
// which forced every mechanic, vet, exporter and cold-store operator to
// misfile themselves as a "TRADER" to get an account at all.
//
// One person routinely holds several of these at once — a farmer who also
// hauls for neighbours in the dry season and repairs their own pumps is
// FARMER + TRANSPORTER + MECHANIC, and should receive work matching all
// three. Capabilities are additive and self-declared; VerificationSource
// and Reputation are what make a claim mean something.
enum Capability {
  FARMER
  BUYER
  SUPPLIER
  TRANSPORTER
  MECHANIC
  VETERINARIAN
  AGRONOMIST
  LABOR_PROVIDER
  COLD_STORAGE
  PROCESSOR
  EXPORTER
  CONTRACTOR
  FINANCIER
  INSURER
  DRONE_OPERATOR
  INSPECTOR
  GOVERNMENT
}

// A second, honest trust signal for cold start — kept structurally separate
// from Reputation (which is computed from transaction history) so it never
// gets blended into a rating average it didn't earn. Set by the founder/an
// admin, never self-declared by the party it describes.
enum VerificationSource {
  FOUNDER
  NETWORK
}

// A Party is any economic participant in agriculture — a farm, a buyer, a
// mechanic, a cold store, a bank. Capabilities aren't exclusive and aren't
// a "type": the same node can supply, buy, haul and repair, and the
// Opportunity engine reads all of them when deciding what work to surface.
model Party {
  id           String       @id @default(cuid())
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id])
  name         String
  capabilities Capability[]
  phone        String?

  // How far this party will actually travel to do business. The single
  // most load-bearing number for matching quality that the original model
  // had no way to express: a Harare cold store serving the whole province
  // and a smallholder who won't go past the next district were treated
  // identically, because both were just "in Harare province".
  operatingRadiusKm Int?
  // Real constraint on who can trade with whom in Zimbabwe — a listing
  // only reachable in English excludes a large share of the market.
  languages         String[]
  // Free-text, one per line: "Class 2 driver's licence", "ZIMRA export
  // permit", "Veterinary Council reg. 4471". Not an enum, because the set
  // is set by regulators and changes on their schedule, not ours.
  licenses          String[]
  yearsExperience   Int?
  // Freeform ("Mon-Sat 6am-6pm", "harvest season only") for the same
  // reason contactDetails is freeform — real availability doesn't fit a
  // structured weekly grid across this range of businesses.
  availabilityNote  String?
  // Freeform, deliberately: a solo farmer writes a WhatsApp number, a large
  // exporter writes an office line, a sales email, and who to ask for.
  // Modeling every business's contact structure as separate fields would
  // fit neither end of that range.
  contactDetails String?
  // ISO 3166-1 alpha-2. Every geographic field below is scoped to it, and
  // nothing outside countries.ts knows what any particular code means.
  countryCode String @default("ZW")
  // Country-neutral names on purpose: `province` is a Zimbabwean and South
  // African word, and this model has to hold US states and UK counties
  // without lying about them. What a user is shown comes from the
  // country's own region1Label/region2Label.
  region     String
  locality   String
  // Derived from the chosen region's centroid at save time, overridable
  // later with an exact position. Matching uses these, not the names —
  // which is what makes cross-border trade reachable at all.
  latitude   Float?
  longitude  Float?
  verifiedBy VerificationSource?
  createdAt  DateTime            @default(now())

  // Last time this party looked at Opportunities — lets the Overview page
  // show what's new *since then* instead of just "top matches right now."
  // Null means "never visited," so everything currently open counts as new.
  opportunitiesLastSeenAt DateTime?

  farm             Farm?
  transportProfile TransportProfile?
  posts            Post[]
  reputation       Reputation?

  ratingsAuthored Rating[] @relation("RatingAuthor")
  ratingsReceived Rating[] @relation("RatingSubject")

  confirmations TransactionConfirmation[]

  relationsAsA Relation[] @relation("RelationPartyA")
  relationsAsB Relation[] @relation("RelationPartyB")

  messages Message[]

  memoryEvents          MemoryEvent[] @relation("MemorySubject")
  memoryCounterpartOf   MemoryEvent[] @relation("MemoryCounterparty")

  blocksMade     PartyBlock[] @relation("BlockActor")
  blocksReceived PartyBlock[] @relation("BlockTarget")
  reportsMade     Report[] @relation("ReportReporter")
  reportsReceived Report[] @relation("ReportSubject")
  auditEvents     AuditEvent[]

  // Set when a party is suspended for abuse. Suspended parties keep their
  // history (it's evidence) but drop out of matching, the directory and
  // every read path — see `activePartyFilter`.
  suspendedAt     DateTime?
  suspendedReason String?

  @@index([countryCode, region, locality])
  @@index([latitude, longitude])
  @@index([capabilities])
}

// ---------------------------------------------------------------------------
// Trust & safety
// ---------------------------------------------------------------------------

// A one-way block. Mutual invisibility is deliberate: if A blocks B, neither
// sees the other anywhere in the product, because a blocked party who can
// still watch your listings and message you through a new match hasn't
// really been blocked. Directional storage (not a sorted pair like Relation)
// because who blocked whom matters for moderation review.
model PartyBlock {
  id        String   @id @default(cuid())
  actorId   String
  actor     Party    @relation("BlockActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId  String
  target    Party    @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([actorId, targetId])
  @@index([actorId])
  @@index([targetId])
}

enum ReportReason {
  SCAM
  MISREPRESENTED_GOODS
  NO_SHOW
  ABUSIVE
  SPAM
  FAKE_ACCOUNT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   Party        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Party        @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  // Optional pointers to what the report is about, so a reviewer isn't
  // reconstructing the incident from prose.
  postId     String?
  matchId    String?
  reason     ReportReason
  detail     String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  @@index([subjectId, status])
  @@index([status, createdAt])
}

// Security-relevant actions, append-only. A marketplace runs on disputes —
// "I never agreed to that", "someone else logged into my account" — and
// without a record of who did what and when, every dispute is one person's
// word against another's. Deliberately separate from MemoryEvent: that's
// the farmer's own business history and is theirs to read; this is a
// security record and exists for the operator.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SIGNUP
  PASSWORD_CHANGED
  SESSIONS_REVOKED
  CONTACT_REVEALED
  PARTY_BLOCKED
  PARTY_UNBLOCKED
  REPORT_FILED
  POST_DELETED
  PROFILE_UPDATED
}

model AuditEvent {
  id      String      @id @default(cuid())
  action  AuditAction
  // Null for pre-auth events (a failed login on an email that doesn't
  // exist still deserves a record — that's what credential stuffing looks
  // like from the inside).
  partyId String?
  party   Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  // The account an action was aimed at, when different from the actor.
  subjectId String?
  // Coarse request context. Deliberately not a full fingerprint: enough to
  // spot "this account was accessed from three countries in an hour",
  // not enough to build a tracking profile.
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([partyId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// Rate-limit state, in the database rather than process memory.
//
// The in-memory limiter it replaces had two holes that only look small
// until someone leans on them: every deploy reset all counters (so an
// attacker just waits for a release), and a second instance would give
// each its own private view of "5 attempts" — the limit silently
// multiplying by the instance count exactly when scale makes it matter.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Farm profile & inventory
// ---------------------------------------------------------------------------

model Farm {
  id           String   @id @default(cuid())
  partyId      String   @unique
  party        Party    @relation(fields: [partyId], references: [id])
  farmName     String
  sizeHectares Float?
  createdAt    DateTime @default(now())

  livestock Livestock[]
  produce   ProduceStock[]
  equipment Equipment[]
}

enum LivestockSpecies {
  CATTLE
  GOAT
  SHEEP
  PIG
  POULTRY
  OTHER
}

enum LivestockSex {
  MALE
  FEMALE
  MIXED
}

// A row is a group (or a single animal, quantity = 1) — real use cases
// (offloading breeding stock, swapping males for genetic diversity) need
// sex tracked at this granularity, not just a species headcount.
model Livestock {
  id        String           @id @default(cuid())
  farmId    String
  farm      Farm             @relation(fields: [farmId], references: [id])
  species   LivestockSpecies
  breed     String?
  sex       LivestockSex
  quantity  Int              @default(1)
  birthDate DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  posts Post[]

  @@index([farmId])
}

enum ProduceUnit {
  KG
  TONNE
  BAG
  CRATE
  LITRE
  HEAD
}

model ProduceStock {
  id                  String      @id @default(cuid())
  farmId              String
  farm                Farm        @relation(fields: [farmId], references: [id])
  cropType            String
  quantity            Float
  unit                ProduceUnit
  harvestDate         DateTime?
  expectedHarvestDate DateTime?
  perishable          Boolean     @default(true)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  posts Post[]

  @@index([farmId])
}

enum EquipmentCategory {
  TRACTOR
  PLOUGH
  IRRIGATION
  TRAILER
  OTHER
}

model Equipment {
  id        String            @id @default(cuid())
  farmId    String
  farm      Farm              @relation(fields: [farmId], references: [id])
  name      String
  category  EquipmentCategory
  condition String?
  available Boolean           @default(true)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  posts Post[]

  @@index([farmId])
}

// ---------------------------------------------------------------------------
// Transport
// ---------------------------------------------------------------------------

enum VehicleType {
  TRUCK
  REFRIGERATED_TRUCK
  PICKUP
  TRAILER
  OTHER
}

model TransportProfile {
  id            String      @id @default(cuid())
  partyId       String      @unique
  party         Party       @relation(fields: [partyId], references: [id])
  vehicleType   VehicleType
  capacityKg    Float?
  serviceRegion String?
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Posts: the symmetric "I have / I need" trading unit
// ---------------------------------------------------------------------------

enum PostType {
  HAVE
  NEED
}

// What the participant is actually trying to *accomplish*. HAVE/NEED is the
// mechanical side of that (which way round the matching engine pairs it),
// and stays — but "HAVE, EQUIPMENT" can't distinguish "I'm selling my
// tractor" from "I'll rent you my tractor" from "I'll plough your field
// with my tractor", which are three different businesses.
//
// Every objective maps to exactly one PostType (see objectives.ts), so the
// existing matching engine keeps working unchanged: this narrows *what
// kind* of pairing is meant, it doesn't replace the pairing rule.
enum Objective {
  SELL
  BUY
  RENT_OUT
  RENT
  HIRE_LABOR
  FIND_WORK
  REPAIR_SERVICE
  NEED_REPAIR
  TRANSPORT_OFFER
  TRANSPORT_NEED
  STORAGE_OFFER
  STORAGE_NEED
  FINANCE_OFFER
  FINANCE_NEED
  INSPECT_OFFER
  INSPECT_NEED
  EXPORT_OFFER
  EXPORT_NEED
}

// Extensible on purpose: v1 ships four categories, but new verticals
// (mechanics, vets, inputs, storage, ...) are future enum values, not new
// subsystems — the Post/Match/Reputation graph doesn't change shape.
enum PostCategory {
  LIVESTOCK
  PRODUCE
  EQUIPMENT
  TRANSPORT
  // Seed, fertilizer, veterinary supplies — what an input shop sells TO
  // farmers rather than trades WITH them. Structurally no different from
  // any other category: a shop is a SUPPLIER-capability Party posting HAVE,
  // a farmer posts NEED, the existing matching engine does the rest.
  INPUTS
  // The four verticals the Objective layer needs in order to cover the
  // whole of agricultural commerce rather than just goods. Exactly what
  // this enum's design note promised: new verticals arrive as enum values,
  // and the Post/Match/Reputation graph doesn't change shape.
  LABOR
  STORAGE
  FINANCE
  // Repair, veterinary, agronomy, inspection, certification, spraying,
  // export brokerage — work performed on someone else's assets. One
  // category rather than six, because they share a shape (a skilled party
  // travels to a farm and does a job) and the Objective already carries
  // which kind of job it is.
  SERVICES
}

enum PostStatus {
  // Auto-drafted (currently: from an approaching harvest date) and waiting
  // on the owner to confirm — never matched against while in this state.
  DRAFT
  OPEN
  MATCHED
  CLOSED
}

model Post {
  id          String       @id @default(cuid())
  partyId     String
  party       Party        @relation(fields: [partyId], references: [id])
  type        PostType
  // Backfilled from `type` on existing rows (HAVE -> SELL, NEED -> BUY),
  // which is what every pre-objective post actually meant.
  objective   Objective    @default(SELL)
  category    PostCategory
  title       String
  description String?
  quantity    Float?
  unit        String?
  countryCode String @default("ZW")
  region      String
  locality    String
  // Copied from the posting party at creation. Denormalised deliberately:
  // a post's location is where the goods are, which is a fact about the
  // post and must not silently move when a party edits their profile.
  latitude    Float?
  longitude   Float?
  askingPrice Decimal?     @db.Decimal(12, 2)
  // Zimbabwe's market runs on both USD and ZWL — a bare number with no
  // label was silently assumed-USD everywhere it was displayed. Freeform
  // like `unit`, not an enum: the canonical list lives in enums.ts as
  // suggestions for the form, not a hard constraint here.
  currency    String       @default("USD")
  status      PostStatus   @default(OPEN)
  // Urgency drives display/ordering today; it's the seam for the delivery
  // layer's pacing rules later — perishables and deadlines shouldn't wait
  // behind a uniform notification cap the way a routine listing can.
  urgent      Boolean      @default(false)
  neededBy    DateTime?
  // A standing order ("I buy 20 tonnes a month") rather than a one-off ask.
  // Purely a declared-intent label today — an open Post already keeps
  // matching against new opposite-type posts for as long as it stays open,
  // so this doesn't change matching behavior, only how it's surfaced.
  recurring   Boolean      @default(false)

  // TRANSPORT-category only: region/locality are the origin (reused,
  // rather than duplicated as originProvince/originDistrict). A HAVE post
  // is a transporter's route; a NEED post's destination is where the goods
  // need to end up. Matching then isn't just "same place" — it's "does
  // this route pass through where you are."
  destinationProvince String?
  destinationDistrict  String?
  travelDate           DateTime?

  // Optional link to the specific inventory item this post refers to.
  livestockId String?
  livestock   Livestock?    @relation(fields: [livestockId], references: [id])
  produceId   String?
  produce     ProduceStock? @relation(fields: [produceId], references: [id])
  equipmentId String?
  equipment   Equipment?    @relation(fields: [equipmentId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  matchesAsA Match[] @relation("MatchPostA")
  matchesAsB Match[] @relation("MatchPostB")
  photos     Photo[]

  @@index([category, status, countryCode, region])
  @@index([status, latitude, longitude])
  @@index([partyId])
  @@index([produceId])
  @@index([livestockId])
  @@index([equipmentId])
}

// Was stored inline in Postgres (bytea) at pilot scale; now uploaded to R2.
// `data` stays on existing rows (nullable rather than backfilled/dropped —
// no reason to touch bytes that already work) and `storageKey` is set on
// everything new. The serving route checks storageKey first, falls back to
// `data` — exactly the seam this model was built to allow.
model Photo {
  id         String   @id @default(cuid())
  postId     String
  // Cascade: no relation in this schema had onDelete set, so every FK
  // defaulted to Restrict — deleting a Post with photos attached would
  // throw. R2 objects still need explicit cleanup in application code
  // first (see deletePhoto call sites); this only handles the DB row.
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  data       Bytes?
  storageKey String?
  mimeType   String
  createdAt  DateTime @default(now())

  @@index([postId])
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

enum MatchStatus {
  SUGGESTED
  ACCEPTED
  DECLINED
  COMPLETED
}

model Match {
  id        String      @id @default(cuid())
  postAId   String
  postA     Post        @relation("MatchPostA", fields: [postAId], references: [id])
  postBId   String
  postB     Post        @relation("MatchPostB", fields: [postBId], references: [id])
  score     Float
  // The kernel's score is never a bare number a projection layer has to
  // trust blindly — it's cited. Each entry is a plain-language reason the
  // match fired ("same district", "counterparty: 3 completed, 4.7★"), so
  // anything downstream (this UI today, WhatsApp phrasing later) renders
  // evidence instead of inventing a justification.
  reasons   String[]
  status    MatchStatus @default(SUGGESTED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  confirmations TransactionConfirmation[]
  ratings       Rating[]
  conversation  Conversation?

  @@unique([postAId, postBId])
  @@index([postBId])
}

// A conversation only exists once a match is ACCEPTED — it's the transaction
// room, not a general chat. One per match (unique matchId), created lazily
// the first time either side opens it.
model Conversation {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         Party        @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Trust: self-reported completion + ratings feed the reputation aggregate
// ---------------------------------------------------------------------------

enum ConfirmationOutcome {
  COMPLETED_GOOD
  COMPLETED_ISSUE
  DID_NOT_HAPPEN
}

model TransactionConfirmation {
  id        String              @id @default(cuid())
  matchId   String
  match     Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party               @relation(fields: [partyId], references: [id])
  outcome   ConfirmationOutcome
  notes     String?
  createdAt DateTime            @default(now())

  @@unique([matchId, partyId])
  @@index([partyId])
}

// One star is not a trust model. "Good produce but pays 60 days late" and
// "pays cash on collection but the maize was damp" both land on 3★, and a
// counterparty deciding whether to extend credit vs. whether to accept a
// delivery window needs to tell those apart.
//
// Deliberately six dimensions and no more: each one has to be something a
// trading party can answer from a single completed trade without guessing.
enum TrustDimension {
  COMMUNICATION
  RELIABILITY
  QUALITY
  PAYMENT
  TIMELINESS
  FAIRNESS
}

// Optional per-dimension detail hanging off a Rating. A rater who only
// moves the overall slider still produces a valid Rating with no
// RatingDimension rows — the dimension averages simply stay null until
// enough people answer them, rather than being back-filled from the
// overall score and inventing a precision nobody supplied.
model RatingDimension {
  id        String         @id @default(cuid())
  ratingId  String
  rating    Rating         @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  dimension TrustDimension
  score     Int

  @@unique([ratingId, dimension])
  @@index([ratingId])
}

model Rating {
  id        String   @id @default(cuid())
  matchId   String?
  // SetNull, not Cascade: a rating is a trust signal about a *party*, with
  // independent value even if the match record it originated from is ever
  // deleted — unlike TransactionConfirmation, it shouldn't disappear with
  // its match.
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  authorId  String
  author    Party    @relation("RatingAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   Party    @relation("RatingSubject", fields: [subjectId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  dimensions RatingDimension[]

  @@unique([matchId, authorId, subjectId])
  @@index([subjectId])
  @@index([authorId])
}

// Denormalized aggregate, recomputed from TransactionConfirmation + Rating
// whenever they change — kept so directory/listing queries don't have to
// scan history on every read.
model Reputation {
  id                  String   @id @default(cuid())
  partyId             String   @unique
  party               Party    @relation(fields: [partyId], references: [id])
  completedCount      Int      @default(0)
  completedGoodCount  Int      @default(0)
  completedIssueCount Int      @default(0)
  averageRating       Float?
  ratingCount         Int      @default(0)
  updatedAt           DateTime @updatedAt

  // Per-dimension averages, each null until at least one rater answered
  // that dimension. Stored as columns rather than a JSON blob so the
  // directory can order and filter on them ("who pays best in Manicaland")
  // without deserializing every row.
  communicationAvg Float?
  reliabilityAvg   Float?
  qualityAvg       Float?
  paymentAvg       Float?
  timelinessAvg    Float?
  fairnessAvg      Float?
  dimensionCount   Int    @default(0)

  // How many distinct counterparties came back for a second completed
  // trade. The strongest trust signal in the whole model and the hardest
  // to fake: anyone can collect one good rating, but repeat business is a
  // counterparty voting with their own money a second time.
  repeatPartnerCount Int @default(0)
  // How many *different* counterparties this record is built from, and how
  // evenly spread across them (0..1). Together these are what separates a
  // genuine track record from a two-account ring that traded with itself:
  // both can reach 14 completed trades and ★4.9, only one of them across
  // eleven independent partners. See trust-integrity.ts.
  distinctPartnerCount Int   @default(0)
  tradeBreadth         Float @default(0)
  // Median minutes to first reply in a conversation, over completed
  // matches. "Responds within the hour" is often what actually decides
  // who gets the work when produce is spoiling.
  medianResponseMinutes Int?
}

// ---------------------------------------------------------------------------
// Relations: repeat trading pairs, as an emergent view over Match history —
// not a separate system, a derived read over the same graph.
// ---------------------------------------------------------------------------

enum RelationKind {
  PREFERRED_PARTNER
  // Not computed yet — detecting a standing recurring order needs pattern
  // inference over time that isn't worth building before there's real
  // transaction volume to infer from. The primitive is modeled now so
  // adding it later is a new enum value, not a new subsystem.
  RECURRING_BUYER
}

// ---------------------------------------------------------------------------
// Operational memory: what this participant actually did, over time
// ---------------------------------------------------------------------------

// The platform's long-term recollection of a participant's operations —
// separate from Post (an intent, which closes) and Match (a pairing, which
// completes). Neither of those can answer "what does this farm normally do
// in August", because both get filtered and closed out of the working set.
//
// Append-only by design: an event is something that happened, so it's never
// updated in place, only recorded. Pattern inference (memory-core.ts) reads
// the log; nothing writes derived conclusions back into it, so a bad
// inference is always one deploy away from being fixed rather than being
// baked permanently into the data.
enum MemoryKind {
  HARVEST
  SOLD
  BOUGHT
  TRANSPORT_HIRED
  TRANSPORT_PROVIDED
  EQUIPMENT_RENTED_OUT
  EQUIPMENT_RENTED_IN
  MAINTENANCE
  INPUTS_PURCHASED
  LABOR_HIRED
  STORAGE_USED
}

model MemoryEvent {
  id      String     @id @default(cuid())
  partyId String
  party   Party      @relation("MemorySubject", fields: [partyId], references: [id], onDelete: Cascade)
  kind    MemoryKind

  // What it was about, in the domain's own words — "oranges", "refrigerated
  // truck", "drip irrigation kit". Freeform because the useful granularity
  // is whatever the farmer actually calls the thing; an enum here would
  // collapse exactly the distinctions that make an anticipation specific
  // enough to be worth showing ("oranges" vs. "citrus" vs. "PRODUCE").
  subject  String
  category PostCategory?

  counterpartyId String?
  counterparty   Party?  @relation("MemoryCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)

  quantity Float?
  unit     String?

  // When it happened, which is not when it was recorded — a harvest logged
  // late still belongs in its real month for seasonality to work.
  occurredAt DateTime
  matchId    String?
  createdAt  DateTime @default(now())

  @@index([partyId, kind, occurredAt])
  @@index([partyId, subject])
  @@index([category, occurredAt])
}

// ---------------------------------------------------------------------------
// Market intelligence: what the economy is doing, derived from the graph
// ---------------------------------------------------------------------------

enum SignalKind {
  DEMAND_RISING
  DEMAND_FALLING
  SUPPLY_TIGHT
  SUPPLY_GLUT
  TRANSPORT_SCARCE
  TRANSPORT_AVAILABLE
  PRICE_RISING
  PRICE_FALLING
}

// Computed from platform activity on a schedule, not written by hand and
// not fetched from an external price feed (there isn't a reliable public
// one for Zimbabwe's informal agricultural market — the platform's own
// order flow is the better signal, and becomes more so with volume).
//
// Every signal carries the sample size it was computed from, because a
// "demand rising" derived from four posts is a rumour and the UI has to be
// able to say so rather than presenting it with the same confidence as one
// derived from four hundred.
model MarketSignal {
  id       String       @id @default(cuid())
  kind     SignalKind
  category PostCategory
  // Crop/commodity when the signal is specific enough to name one.
  subject  String?
  countryCode String?
  region      String?

  headline String
  detail   String
  // 0..1 — how much weight the UI should give this, driven by sample size
  // and effect magnitude together.
  strength Float
  // Number of underlying posts/matches the signal was computed from.
  sampleSize Int

  windowStart DateTime
  windowEnd   DateTime
  computedAt  DateTime @default(now())

  @@index([countryCode, region, category, computedAt])
  @@index([computedAt])
}

// partyAId/partyBId are stored in sorted order (no canonical "direction"
// between two trading partners) so a pair never produces two rows.
model Relation {
  id        String       @id @default(cuid())
  partyAId  String
  partyA    Party        @relation("RelationPartyA", fields: [partyAId], references: [id])
  partyBId  String
  partyB    Party        @relation("RelationPartyB", fields: [partyBId], references: [id])
  kind      RelationKind
  strength  Int          @default(1)
  formedAt  DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([partyAId, partyBId, kind])
  @@index([partyBId])
}
