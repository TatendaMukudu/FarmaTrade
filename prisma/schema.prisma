// FarmaTrade data model.
//
// Single connected graph: every farm, buyer, seller, and transporter is a
// Party. A Party can extend itself with a Farm profile (asset inventory)
// and/or a TransportProfile (hauling capacity) — these aren't separate
// systems, just optional facets of the same node.
//
// Trading is symmetric: a Party records SUPPLY intent or DEMAND intent, and
// the matching engine pairs the two sides. No payment
// rails — settlement happens off-platform (cash, EcoCash, bank transfer).
// Reputation is seeded by self-reported transaction confirmations from
// both sides of a match, not by verified payment data (that's a known,
// deliberate weak point until a licensed payment aggregator is wired in).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & parties
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())

  party Party?
}

enum PartyRole {
  FARM
  TRADER
  TRANSPORTER
}

// A second, honest trust signal for cold start — kept structurally separate
// from Reputation (which is computed from transaction history) so it never
// gets blended into a rating average it didn't earn. Set by the founder/an
// admin, never self-declared by the party it describes.
enum VerificationSource {
  FOUNDER
  NETWORK
}

// A Party is any actor in the network: a farm owner, a buyer/seller with no
// farm of their own (e.g. a produce trader or a grocery store), or a
// transport provider. Roles aren't exclusive — a farm can also haul.
model Party {
  id         String              @id @default(cuid())
  userId     String?             @unique
  user       User?               @relation(fields: [userId], references: [id])
  name       String
  roles      PartyRole[]
  phone      String?
  // Freeform, deliberately: a solo farmer writes a WhatsApp number, a large
  // exporter writes an office line, a sales email, and who to ask for.
  // Modeling every business's contact structure as separate fields would
  // fit neither end of that range.
  contactDetails String?
  // ISO 3166-1 alpha-2. Decides how FarmaTrade talks to this party — what
  // its administrative levels are called, which currency prices are in,
  // which timezone "good morning" is judged against (see lib/regions.ts).
  // It does NOT decide who they may trade with: cross-border trade is a
  // per-intent opt-in, not a nationality.
  countryCode String  @default("ZW")
  province   String
  district   String
  latitude   Float?
  longitude  Float?
  verifiedBy VerificationSource?
  createdAt  DateTime            @default(now())

  // Last time this party looked at Opportunities — lets the Overview page
  // show what's new *since then* instead of just "top matches right now."
  // Null means "never visited," so everything currently open counts as new.
  opportunitiesLastSeenAt DateTime?

  farm             Farm?
  transportProfile TransportProfile?
  intents          Intent[]
  reputation       Reputation?

  ratingsAuthored Rating[] @relation("RatingAuthor")
  ratingsReceived Rating[] @relation("RatingSubject")

  confirmations TransactionConfirmation[]
  termsProposed AgreementTerms[]
  termsAccepted TermsAcceptance[]

  relationsAsA Relation[] @relation("RelationPartyA")
  relationsAsB Relation[] @relation("RelationPartyB")

  messages Message[]

  @@index([province, district])
}

// ---------------------------------------------------------------------------
// Farm profile & inventory
// ---------------------------------------------------------------------------

model Farm {
  id           String   @id @default(cuid())
  partyId      String   @unique
  party        Party    @relation(fields: [partyId], references: [id])
  farmName     String
  sizeHectares Float?
  createdAt    DateTime @default(now())

  livestock Livestock[]
  produce   ProduceStock[]
  equipment Equipment[]
}

enum LivestockSpecies {
  CATTLE
  GOAT
  SHEEP
  PIG
  POULTRY
  OTHER
}

enum LivestockSex {
  MALE
  FEMALE
  MIXED
}

// A row is a group (or a single animal, quantity = 1) — real use cases
// (offloading breeding stock, swapping males for genetic diversity) need
// sex tracked at this granularity, not just a species headcount.
model Livestock {
  id        String           @id @default(cuid())
  farmId    String
  farm      Farm             @relation(fields: [farmId], references: [id])
  species   LivestockSpecies
  breed     String?
  sex       LivestockSex
  quantity  Int              @default(1)
  birthDate DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  intents Intent[]

  @@index([farmId])
}

enum ProduceUnit {
  KG
  TONNE
  BAG
  CRATE
  LITRE
  HEAD
}

model ProduceStock {
  id                  String      @id @default(cuid())
  farmId              String
  farm                Farm        @relation(fields: [farmId], references: [id])
  // What the farmer calls it, exactly as they typed it. Never normalised,
  // never overwritten — "Mhunga" stays "Mhunga" on their own records.
  cropType            String
  // What it resolves to. Nullable: an unrecognised crop is still a perfectly
  // good inventory row, it just can't be commodity-matched until someone
  // adds the alias.
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id])
  quantity            Float
  unit                ProduceUnit
  harvestDate         DateTime?
  expectedHarvestDate DateTime?
  perishable          Boolean     @default(true)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  intents Intent[]

  @@index([farmId])
}

enum EquipmentCategory {
  TRACTOR
  PLOUGH
  IRRIGATION
  TRAILER
  OTHER
}

model Equipment {
  id        String            @id @default(cuid())
  farmId    String
  farm      Farm              @relation(fields: [farmId], references: [id])
  name      String
  category  EquipmentCategory
  condition String?
  available Boolean           @default(true)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  intents Intent[]

  @@index([farmId])
}

// ---------------------------------------------------------------------------
// Transport
// ---------------------------------------------------------------------------

enum VehicleType {
  TRUCK
  REFRIGERATED_TRUCK
  PICKUP
  TRAILER
  OTHER
}

model TransportProfile {
  id            String      @id @default(cuid())
  partyId       String      @unique
  party         Party       @relation(fields: [partyId], references: [id])
  vehicleType   VehicleType
  capacityKg    Float?
  serviceRegion String?
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Product identity: what a thing is, independent of what anyone calls it
//
// Matching had no commodity concept — two intents paired because both were
// PRODUCE, so a maize seller and a tomato buyer matched. cropType was
// recorded and never read by the matcher.
//
// A Product is the thing itself. A ProductAlias is any name it goes by,
// including Shona and Ndebele. The farmer owns the language; this owns the
// ontology underneath, so a buyer's "pearl millet" finds a farmer's "mhunga"
// without either of them changing how they write.
// ---------------------------------------------------------------------------

enum ProductKind {
  CROP
  LIVESTOCK
}

model Product {
  id       String      @id @default(cuid())
  // Stable machine key ("pearl_millet"). Never shown to a farmer.
  key      String      @unique
  kind     ProductKind
  // What FarmaTrade calls it when it has to speak for itself — a market
  // summary, a requirement with no local wording of its own.
  name     String
  // Bridges to CommerceCategory so anything without a product identity
  // (transport, services, inputs) still matches the way it always has.
  category CommerceCategory

  aliases  ProductAlias[]
  intents  Intent[]
  produce  ProduceStock[]

  @@index([category])
}

enum AliasSource {
  // Shipped in the seed catalogue.
  SEEDED
  // Learned from what a farmer actually typed, once an admin confirmed it.
  LEARNED
}

model ProductAlias {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  // Lookup form: lowercased, accents folded, punctuation stripped. Unique
  // across the whole table on purpose — one term resolves to at most one
  // product, so ambiguity is settled deliberately rather than guessed at
  // runtime.
  normalized String     @unique
  // Exactly as written, so a farmer's own spelling survives into the UI.
  label     String
  // BCP-47-ish: "en", "sn" (Shona), "nd" (Ndebele).
  locale    String?
  source    AliasSource @default(SEEDED)
  createdAt DateTime    @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Intent: what a party is willing to do, and why FarmaTrade believes it
//
// Not a listing. An intent references farm state without being it: a farmer
// holding 26 tonnes who offers 20 has one inventory row saying 26 and one
// intent saying 20. Creating, matching or withdrawing an intent never
// touches inventory — only fulfilment does.
//
// See src/lib/intent.ts.
// ---------------------------------------------------------------------------

// The two sides of a market. Not "kinds" of intent — a supply intent and a
// demand intent are the same object facing opposite ways.
enum IntentSide {
  SUPPLY
  DEMAND
}

// Extensible on purpose: v1 ships four categories, but new verticals
// (mechanics, vets, inputs, storage, ...) are future enum values, not new
// subsystems — the Intent/Match/Reputation graph doesn't change shape.
// The kind of commerce, used by both Intent and Product. Named for neither
// owner because it belongs to both: Product carries it so a catalogue entry
// knows where it trades, and Intent carries it because transport, equipment
// and inputs have no product identity at all and category is the only thing
// matching can narrow on for them.
enum CommerceCategory {
  LIVESTOCK
  PRODUCE
  EQUIPMENT
  TRANSPORT
  // Seed, fertilizer, veterinary supplies — what an input shop sells TO
  // farmers rather than trades WITH them. Structurally no different from
  // any other category: a shop is a TRADER-role Party (already meant to
  // cover "a buyer/seller with no farm of their own") posting HAVE, a
  // farmer records DEMAND, the existing matching engine does the rest.
  INPUTS
}

// Why an intent exists. DERIVED is the path FarmaTrade is moving toward:
// it already knows the farm has 26 tonnes of maize with a harvest date, so
// it proposes the availability and the farmer confirms. DECLARED remains for
// everything with no underlying record — a buyer's requirement, a
// transporter's capacity, a need for something the farm does not have.
//
// See src/lib/intent.ts.
enum IntentOrigin {
  DERIVED
  DECLARED
}

// Where an intent sits commercially.
//
// ENGAGED is explicitly NOT terminal and must not become a synonym for
// "done". It means commercial interaction has started around this intent —
// which is compatible with the intent being partially committed, carrying
// several matches at once, or returning to ACTIVE when a negotiation falls
// through. Fulfilment semantics are a later layer; nothing here should be
// read as closing anything.
enum IntentStatus {
  // Derived by FarmaTrade and waiting on its owner to confirm. Never matched
  // against while in this state — matching on something nobody has agreed to
  // would be putting words in their mouth.
  PROPOSED
  ACTIVE
  ENGAGED
  WITHDRAWN
}

model Intent {
  id          String       @id @default(cuid())
  partyId     String
  party       Party        @relation(fields: [partyId], references: [id])
  // Whether FarmaTrade proposed this from what it already knows, or the
  // party stated it outright. Defaults to DECLARED because every row that
  // predates this column was typed by hand.
  origin      IntentOrigin @default(DECLARED)
  // A fingerprint of the farm state a DERIVED intent came from — quantity,
  // timing, product and unit. Null on anything DECLARED.
  //
  // Two jobs, both needing exactness. A proposal whose key still matches its
  // source hasn't gone stale. And a proposal the farmer declined stays
  // declined while the key is unchanged — the withdrawn row IS the
  // suppression, which is why "not selling this" withdraws rather than
  // deletes. If the harvest genuinely changes, that's a different commercial
  // question and asking again is fair.
  derivationKey String?
  side        IntentSide
  category    CommerceCategory
  title       String
  description String?
  quantity    Float?
  // What the owner typed, kept exactly as they wrote it. Display and audit
  // only — it is no longer what the machine reasons about.
  unit        String?
  // Canonical unit identity: METRIC_TONNE, KILOGRAM, BAG and so on. THIS is
  // the machine source of truth for what the quantity means.
  //
  // Null where the text could not be resolved deterministically, and that
  // null is load-bearing: an intent measured in "punnets" is a perfectly
  // good intent whose quantity FarmaTrade cannot compare with anything, and
  // guessing a unit for it would be inventing the size of a trade. See
  // lib/measurement.ts.
  unitCode    String?
  // What this is actually about. Nullable because it cannot be known for a
  // transport or service post, and because existing rows predate it —
  // matching treats "unknown" as "can't rule it out" and falls back to
  // category, which is the behaviour that has always applied.
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id])
  // Denormalized from the party at post time, exactly as province/district
  // already are, so the matching query can filter on it without a join.
  countryCode String       @default("ZW")
  province    String
  district    String
  // Matching is local-first by default: a smallholder with two tonnes of
  // tomatoes should not wade through buyers on another continent. But a
  // larger farm exporting into the region is a real and wanted case, so
  // reach is the poster's choice rather than ours. Opting in ADDS
  // international candidates; it never removes local ones, and a match only
  // ever crosses a border when BOTH sides asked for it.
  openToCrossBorder Boolean @default(false)
  askingPrice Decimal?     @db.Decimal(12, 2)
  status      IntentStatus @default(ACTIVE)
  // Urgency drives display/ordering today; it's the seam for the delivery
  // layer's pacing rules later — perishables and deadlines shouldn't wait
  // behind a uniform notification cap the way a routine listing can.
  urgent      Boolean      @default(false)
  neededBy    DateTime?
  // A standing order ("I buy 20 tonnes a month") rather than a one-off ask.
  // Purely a declared-intent label today — an active intent already keeps
  // matching against opposite-side intents for as long as it stays active,
  // so this doesn't change matching behavior, only how it's surfaced.
  recurring   Boolean      @default(false)

  // TRANSPORT-category only: province/district are the origin (reused,
  // rather than duplicated as originProvince/originDistrict). A HAVE post
  // is a transporter's route; a NEED post's destination is where the goods
  // need to end up. Matching then isn't just "same place" — it's "does
  // this route pass through where you are."
  destinationProvince String?
  destinationDistrict  String?
  travelDate           DateTime?

  // Optional link to the specific inventory item this post refers to.
  livestockId String?
  livestock   Livestock?    @relation(fields: [livestockId], references: [id])
  produceId   String?
  produce     ProduceStock? @relation(fields: [produceId], references: [id])
  equipmentId String?
  equipment   Equipment?    @relation(fields: [equipmentId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  matchesAsA Match[] @relation("MatchIntentA")
  matchesAsB Match[] @relation("MatchIntentB")
  photos     Photo[]

  @@index([category, status, countryCode, province, district])
  // The matching query narrows on product identity before geography once
  // both sides are known.
  @@index([productId, status, side])
  // The derivation engine looks up everything already derived from one
  // source, whatever its status.
  @@index([partyId, derivationKey])
  @@index([unitCode])
  @@index([partyId])
  @@index([produceId])
  // The cross-border arm of the matching query looks up opted-in intents
  // without a country or province to narrow on, so it needs its own index.
  @@index([category, status, openToCrossBorder])
}

// Was stored inline in Postgres (bytea) at pilot scale; now uploaded to R2.
// `data` stays on existing rows (nullable rather than backfilled/dropped —
// no reason to touch bytes that already work) and `storageKey` is set on
// everything new. The serving route checks storageKey first, falls back to
// `data` — exactly the seam this model was built to allow.
model Photo {
  id         String   @id @default(cuid())
  intentId   String
  intent     Intent   @relation(fields: [intentId], references: [id])
  data       Bytes?
  storageKey String?
  mimeType   String
  createdAt  DateTime @default(now())

  @@index([intentId])
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

// Where an engagement has got to between two parties.
//
// The distinction the whole model turns on is between one party acting and
// both parties agreeing. Only the second reserves anybody's capacity, and
// the enum says which is which rather than leaving it to a convention some
// call site can forget.
enum MatchStatus {
  // FarmaTrade found a possible pairing. Nobody has answered.
  SUGGESTED
  // At least one party has engaged — terms are on the table, or one side
  // has accepted and is waiting for the other. Consumes nothing.
  NEGOTIATING
  // Both parties accepted the same version of the same terms. This is the
  // only state that reserves capacity, and it is provable from the
  // acceptance rows rather than asserted by whoever wrote the status.
  AGREED
  // Reported done by both sides.
  COMPLETED
  // Declined before agreement, or cancelled after it.
  DECLINED
  // Legacy only. Never written by current code.
  //
  // Before bilateral agreement existed, one party could move a match here
  // alone, and that reserved the counterparty's capacity — a buyer could
  // reserve a farmer's tonnage without the farmer ever answering. Rows left
  // in this state are engagements whose consent was never proven, so they
  // reserve nothing and both parties are asked to agree properly. The
  // status is kept precisely so those rows stay identifiable instead of
  // being backfilled into a consent nobody gave.
  ACCEPTED
}

model Match {
  id        String      @id @default(cuid())
  intentAId String
  intentA   Intent      @relation("MatchIntentA", fields: [intentAId], references: [id])
  intentBId String
  intentB   Intent      @relation("MatchIntentB", fields: [intentBId], references: [id])
  score     Float
  // The kernel's score is never a bare number a projection layer has to
  // trust blindly — it's cited. Each entry is a plain-language reason the
  // match fired ("same district", "counterparty: 3 completed, 4.7★"), so
  // anything downstream (this UI today, WhatsApp phrasing later) renders
  // evidence instead of inventing a justification.
  reasons   String[]
  status    MatchStatus @default(SUGGESTED)
  // LEGACY. The quantity a single party's acceptance reserved, before
  // agreement was bilateral. New engagements record their quantity on the
  // AgreementTerms version both parties accepted, and that is what capacity
  // is derived from — see agreement-core.ts.
  //
  // Still read for one case, and only one: a COMPLETED match with no terms
  // rows. Two confirmations exist there, which is real evidence both
  // parties acted, so its quantity is grandfathered rather than dropped.
  // A legacy ACCEPTED match carries no such evidence and reserves nothing.
  quantity  Float?
  unit      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  confirmations TransactionConfirmation[]
  ratings       Rating[]
  conversation  Conversation?
  terms         AgreementTerms[]

  @@unique([intentAId, intentBId])
  @@index([intentBId])
}

// One version of the commercial terms of an engagement.
//
// Agreement is meaningless unless both parties agreed to the *same deal*, so
// the deal needs an identity to point at. Without one, this sequence looks
// like consent and is not:
//
//   1. the farmer agrees to 10 tonnes
//   2. the buyer agrees to 10 tonnes
//   3. the buyer changes it to 15
//   4. the system still says both agreed
//
// Versions are immutable and append-only. Changing a term does not edit a
// row; it writes the next version, which starts with no acceptances at all.
// That is what makes step 4 impossible rather than merely discouraged —
// consent is a row pointing at a specific version, and there is nothing for
// it to silently carry forward onto.
//
// The fields are the terms FarmaTrade actually represents today. Delivery
// arrangements, payment method and quality grade are deliberately absent:
// inventing fields a marketplace usually has would be modelling a product
// nobody has asked for, and each one added here is another term consent has
// to be exact about.
model AgreementTerms {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id])
  // Monotonic per match, starting at 1. The ordering is what "the latest
  // terms both parties accepted" is resolved against.
  version Int
  // Null where the two sides' units cannot be compared, or neither named an
  // amount. An agreement without a quantity is still a real agreement; it
  // just reserves no measured capacity. See capacity.ts.
  quantity   Float?
  // What was typed, for showing the parties what they agreed in their own
  // words.
  unit       String?
  // Canonical unit identity, snapshot at proposal time.
  //
  // Stored rather than re-resolved from `unit`, and that is the whole point
  // of it being here: what two parties agreed to must not be able to change
  // because an alias table changed later. The code fixes the physical
  // meaning permanently, the way the price snapshot fixes the money.
  unitCode   String?
  // Snapshot, not a live read of Intent.askingPrice. A seller raising their
  // asking price must not retroactively change what a buyer agreed to pay.
  price      Decimal?  @db.Decimal(12, 2)
  handoverOn DateTime?
  // Who put these terms on the table. Proposing is itself an acceptance —
  // see the TermsAcceptance written alongside.
  proposedById String
  proposedBy   Party  @relation(fields: [proposedById], references: [id])
  createdAt    DateTime @default(now())

  acceptances TermsAcceptance[]

  @@unique([matchId, version])
  @@index([matchId])
  @@index([proposedById])
}

// One party's consent to one version of the terms.
//
// Modelled on TransactionConfirmation, which is the only other place in
// FarmaTrade where two parties each have to say something and neither may
// speak for the other: a row per party, unique per subject, append-only.
// Consent that can be overwritten is not consent.
//
// Party identity rather than buyer/seller flags, because a match pairs two
// intents and nothing guarantees they are opposite sides forever — a
// transport pairing already has no buyer.
model TermsAcceptance {
  id      String         @id @default(cuid())
  termsId String
  terms   AgreementTerms @relation(fields: [termsId], references: [id])
  partyId String
  party   Party          @relation(fields: [partyId], references: [id])
  // When this party agreed, so "who agreed, to what, and when" is
  // answerable without reconstructing it from an audit log.
  createdAt DateTime @default(now())

  @@unique([termsId, partyId])
  @@index([partyId])
}

// A conversation only exists once a match is ACCEPTED — it's the transaction
// room, not a general chat. One per match (unique matchId), created lazily
// the first time either side opens it.
model Conversation {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id])
  createdAt DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  authorId       String
  author         Party        @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Trust: self-reported completion + ratings feed the reputation aggregate
// ---------------------------------------------------------------------------

enum ConfirmationOutcome {
  COMPLETED_GOOD
  COMPLETED_ISSUE
  DID_NOT_HAPPEN
}

model TransactionConfirmation {
  id        String              @id @default(cuid())
  matchId   String
  match     Match               @relation(fields: [matchId], references: [id])
  partyId   String
  party     Party               @relation(fields: [partyId], references: [id])
  outcome   ConfirmationOutcome
  notes     String?
  createdAt DateTime            @default(now())

  @@unique([matchId, partyId])
  @@index([partyId])
}

model Rating {
  id        String   @id @default(cuid())
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id])
  authorId  String
  author    Party    @relation("RatingAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   Party    @relation("RatingSubject", fields: [subjectId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([matchId, authorId, subjectId])
  @@index([subjectId])
}

// Denormalized aggregate, recomputed from TransactionConfirmation + Rating
// whenever they change — kept so directory/listing queries don't have to
// scan history on every read.
model Reputation {
  id                  String   @id @default(cuid())
  partyId             String   @unique
  party               Party    @relation(fields: [partyId], references: [id])
  completedCount      Int      @default(0)
  completedGoodCount  Int      @default(0)
  completedIssueCount Int      @default(0)
  // Deliberately outside completedCount: a trade that never happened is not
  // a completed one, and averaging it into a "trades done" figure would
  // erase the single most informative negative signal the schema collects.
  // Kept as its own count so ranking can read it without it ever touching a
  // rating average it didn't earn.
  didNotHappenCount   Int      @default(0)
  averageRating       Float?
  ratingCount         Int      @default(0)
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Relations: repeat trading pairs, as an emergent view over Match history —
// not a separate system, a derived read over the same graph.
// ---------------------------------------------------------------------------

enum RelationKind {
  PREFERRED_PARTNER
  // Not computed yet — detecting a standing recurring order needs pattern
  // inference over time that isn't worth building before there's real
  // transaction volume to infer from. The primitive is modeled now so
  // adding it later is a new enum value, not a new subsystem.
  RECURRING_BUYER
}

// partyAId/partyBId are stored in sorted order (no canonical "direction"
// between two trading partners) so a pair never produces two rows.
model Relation {
  id        String       @id @default(cuid())
  partyAId  String
  partyA    Party        @relation("RelationPartyA", fields: [partyAId], references: [id])
  partyBId  String
  partyB    Party        @relation("RelationPartyB", fields: [partyBId], references: [id])
  kind      RelationKind
  strength  Int          @default(1)
  formedAt  DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([partyAId, partyBId, kind])
  @@index([partyBId])
}
